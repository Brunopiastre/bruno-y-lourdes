<section class="redes">
  <h2>Seguinos</h2>
  <div class="links-iconos">
    <a href="https://www.youtube.com/@somoslaparejitafeliz" target="_blank" rel="noopener" class="icono-red">
      <span class="circulo">
        <svg viewBox="0 0 24 24" width="28" height="28" fill="#FF0000"><path d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.5 12 3.5 12 3.5s-7.5 0-9.4.6A3 3 0 0 0 .5 6.2 31 31 0 0 0 0 12a31 31 0 0 0 .5 5.8 3 3 0 0 0 2.1 2.1c1.9.6 9.4.6 9.4.6s7.5 0 9.4-.6a3 3 0 0 0 2.1-2.1A31 31 0 0 0 24 12a31 31 0 0 0-.5-5.8ZM9.6 15.6V8.4l6.3 3.6-6.3 3.6Z"/></svg>
      </span>
      <span class="etiqueta-red">YouTube</span>
    </a>
    <a href="https://www.tiktok.com/@somoslaparejitafeliz" target="_blank" rel="noopener" class="icono-red">
      <span class="circulo">
        <svg viewBox="0 0 24 24" width="28" height="28" fill="#000000"><path d="M16.6 5.8a4.3 4.3 0 0 1-3.3-4H10v13.2a2.6 2.6 0 1 1-1.9-2.5V9.4a6 6 0 1 0 5.2 6V9.6a7.6 7.6 0 0 0 4.4 1.4V7.9a4.3 4.3 0 0 1-1.1-2.1Z"/></svg>
      </span>
      <span class="etiqueta-red">TikTok</span>
    </a>
  </div>
  <p class="footer">q lujo tener un novio que te haga una pagina web</p>
</section>

<style>
  .redes {
    padding: 4rem 1.5rem;
    text-align: center;
  }
  .redes h2 {
    color: var(--color-secundario);
    font-size: clamp(1.6rem, 5vw, 2.2rem);
  }
  .links-iconos {
    display: flex;
    gap: 2rem;
    justify-content: center;
    margin-top: 1.8rem;
    flex-wrap: wrap;
  }
  .icono-red {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
  }
  .circulo {
    width: 60px;
    height: 60px;
    background: white;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: var(--sombra);
    transition: transform 0.2s;
  }
  .icono-red:hover .circulo {
    transform: scale(1.1);
  }
  .etiqueta-red {
    font-weight: 600;
    color: var(--color-secundario);
    font-size: 0.9rem;
  }
  .footer {
    margin-top: 3rem;
    font-size: 0.95rem;
    color: var(--color-texto-suave);
    font-style: italic;
  }
</style>
