---
---
<div class="enredadera-contenedor" aria-hidden="true">
  <svg
    id="svg-enredadera"
    class="enredadera-svg"
    viewBox="0 0 60 1000"
    preserveAspectRatio="none"
  >
    <path
      id="tallo-enredadera"
      d="M30 1000 C 10 900, 50 800, 20 700 C -5 620, 45 560, 15 480 C -10 420, 45 360, 20 280 C 0 220, 45 160, 25 90 C 15 55, 35 25, 30 0"
      fill="none"
      stroke="#6fae7c"
      stroke-width="4"
      stroke-linecap="round"
    />
    <g class="hoja" data-umbral="0.15" transform="translate(15 780) rotate(-20)">
      <path d="M0 0 C 10 -6, 20 -2, 22 8 C 12 14, 2 10, 0 0 Z" fill="#7fbf8e" />
    </g>
    <g class="hoja" data-umbral="0.35" transform="translate(10 560) rotate(15)">
      <path d="M0 0 C 10 -6, 20 -2, 22 8 C 12 14, 2 10, 0 0 Z" fill="#8cc99a" />
    </g>
    <g class="hoja" data-umbral="0.55" transform="translate(20 360) rotate(-25)">
      <path d="M0 0 C 10 -6, 20 -2, 22 8 C 12 14, 2 10, 0 0 Z" fill="#7fbf8e" />
    </g>
    <g class="hoja" data-umbral="0.75" transform="translate(12 160) rotate(20)">
      <path d="M0 0 C 10 -6, 20 -2, 22 8 C 12 14, 2 10, 0 0 Z" fill="#8cc99a" />
    </g>
    <g class="hoja" data-umbral="0.9" transform="translate(22 50) rotate(-15)">
      <circle cx="8" cy="4" r="6" fill="#e8a1c4" />
    </g>
  </svg>
</div>

<style>
  .enredadera-contenedor {
    position: fixed;
    top: 0;
    right: 0;
    width: 40px;
    height: 100vh;
    pointer-events: none;
    z-index: 400;
    opacity: 0.9;
  }
  .enredadera-svg {
    width: 100%;
    height: 100%;
    display: block;
  }
  .hoja {
    opacity: 0;
    transition: opacity 0.6s ease;
  }
  .hoja.visible {
    opacity: 1;
  }
  @media (max-width: 640px) {
    .enredadera-contenedor {
      width: 24px;
    }
  }
</style>

<script>
  const tallo = document.getElementById("tallo-enredadera") as SVGPathElement | null;
  const hojas = document.querySelectorAll<SVGGElement>(".hoja");

  if (tallo) {
    const largo = tallo.getTotalLength();
    tallo.style.strokeDasharray = `${largo}`;
    tallo.style.strokeDashoffset = `${largo}`;

    function actualizar() {
      const alturaTotal = document.documentElement.scrollHeight - window.innerHeight;
      const progreso = alturaTotal > 0 ? Math.min(window.scrollY / alturaTotal, 1) : 0;

      tallo!.style.strokeDashoffset = `${largo - largo * progreso}`;

      hojas.forEach((hoja) => {
        const umbral = parseFloat(hoja.dataset.umbral || "1");
        hoja.classList.toggle("visible", progreso >= umbral);
      });
    }

    actualizar();
    window.addEventListener("scroll", actualizar, { passive: true });
    window.addEventListener("resize", actualizar);
  }
</script>
